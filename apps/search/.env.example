# Search service configuration.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables — see docs/MANUAL_SETUP.md.

# ---- identity --------------------------------------------------------------
SERVICE_NAME=search
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
PORT=8003
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- datastores ------------------------------------------------------------
# The search service owns the `search` schema. Note what lives there: the index
# ledger and search analytics. No catalogue data — the index is a cache of the
# books service, and every document in it can be rebuilt from source.
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos
DATABASE_SCHEMA=search
REDIS_URL=redis://localhost:6379/0

# ---- auth ------------------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
INTERNAL_API_SECRET=dev-internal-secret-change-me

# ---- service discovery -----------------------------------------------------
# Reconciliation walks the books service's own listing endpoints. The index is
# never rebuilt by reading another service's schema.
BOOKS_SERVICE_URL=http://localhost:8002

# ---- networking ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---- meilisearch -----------------------------------------------------------
MEILISEARCH_URL=http://localhost:7700
# A master key, or an API key with document + settings write scope. Required in
# production: without it anyone who can reach the engine can rewrite the index.
MEILISEARCH_MASTER_KEY=
# Query budget. Deliberately under a second — this sits on the user's critical
# path, and a hung request holds a worker slot open until it times out, turning
# "search is slow" into "the gateway's connection pool is exhausted".
MEILISEARCH_TIMEOUT=3
MEILISEARCH_CONNECT_TIMEOUT=2
# Indexing is batched and runs off the request path, so it gets a longer budget.
MEILISEARCH_INDEX_TIMEOUT=30
# Lets staging and production share one engine without colliding.
INDEX_PREFIX=kos

# ---- indexing --------------------------------------------------------------
# Documents per request. 50k in one body is a request that times out, retries,
# and times out again.
INDEX_BATCH_SIZE=500
# Backpressure: Meilisearch queues tasks, and a reindex that saturates the queue
# starves the live updates arriving from book events.
INDEX_MAX_CONCURRENT_BATCHES=2
INDEX_BATCH_PAUSE_SECONDS=0.05
RECONCILE_PAGE_SIZE=200
RECONCILE_MAX_DOCUMENTS=100000
# Held for the duration of a rebuild. Two replicas rebuilding at once would each
# delete the other's freshly written documents.
REINDEX_LOCK_SECONDS=1800

# ---- query -----------------------------------------------------------------
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
AUTOCOMPLETE_LIMIT=8
AUTOCOMPLETE_TIMEOUT=1
RELATED_LIMIT=12
FACET_MAX_VALUES=20

# ---- trending --------------------------------------------------------------
TRENDING_ENABLED=true
TRENDING_WINDOW_HOURS=24
# Weight per hour of age: 0.9 ** 24 is about 0.08, so a search from yesterday
# counts for a twelfth of one from this hour. This is what makes it *trending*
# rather than *all-time popular*.
TRENDING_DECAY_PER_HOUR=0.9
TRENDING_MAX_TERMS=20
# Single letters are keystrokes, not intent, and would dominate the ranking.
TRENDING_MIN_QUERY_LENGTH=3

# ---- analytics -------------------------------------------------------------
ANALYTICS_ENABLED=true
ANALYTICS_MAX_QUERY_LENGTH=200

# ---- semantic search (opt-in) ----------------------------------------------
# Off by default, and the service is fully functional without a single embedding.
# Turning it on requires an embedder registered with Meilisearch under the name
# in SEMANTIC_EMBEDDER — see the README before enabling it in production.
SEMANTIC_ENABLED=false
SEMANTIC_EMBEDDER=default
# 0.0 = pure keyword, 1.0 = pure vector.
SEMANTIC_RATIO=0.5
EMBEDDING_BACKEND=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ---- events ----------------------------------------------------------------
EVENTS_ENABLED=true
EVENT_CONSUMER_GROUP=search
