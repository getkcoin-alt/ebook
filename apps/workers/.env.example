# Workers service configuration.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables — see docs/MANUAL_SETUP.md.

# ---- identity --------------------------------------------------------------
SERVICE_NAME=workers
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
PORT=8009
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- datastores ------------------------------------------------------------
# This service owns exactly one table: its own run history. It never touches
# another service's schema — everything it does goes through that service's
# `/internal/maintenance/*` route.
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos
DATABASE_SCHEMA=workers
# Also the Celery broker and the single-flight lock store.
REDIS_URL=redis://localhost:6379/0

# ---- auth ------------------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
# The credential that opens every `/internal/*` route on every other service.
# It must match theirs exactly or every scheduled job fails with a 401.
INTERNAL_API_SECRET=dev-internal-secret-change-me

# ---- service discovery -----------------------------------------------------
# Every service this scheduler calls. A missing URL here means those jobs fail
# every time they fire, which is why `/v1/admin/workers/health` reports them.
AUTH_SERVICE_URL=http://localhost:8001
BOOKS_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
AUTOMATION_SERVICE_URL=http://localhost:8007

# ---- schedule --------------------------------------------------------------
# Jobs switched off for this deployment, comma-separated, by name. A deployment
# with no Meilisearch or no AI provider should switch those off rather than let
# them fail every hour — a job that fails by design teaches everyone to ignore
# the failure count, and then the one that matters goes unnoticed too.
#   DISABLED_JOBS=search.reconcile,search.prune-analytics,ai.prune
DISABLED_JOBS=

# How long a run record is kept. Long enough to answer "has the nightly reconcile
# been failing all week?", which is what this history exists for.
RUN_RETENTION_DAYS=30

# Consecutive failures before a job reports unhealthy. One is noise — a deploy, a
# restart, a blip. Three in a row is a signal.
UNHEALTHY_AFTER_FAILURES=3

MAX_ATTEMPTS=2
RETRY_DELAY_SECONDS=30

# Beat's own schedule state. Ephemeral by design: losing it means at worst one
# duplicate run, and the single-flight lock makes that a no-op.
BEAT_SCHEDULE_PATH=/tmp/celerybeat-schedule
