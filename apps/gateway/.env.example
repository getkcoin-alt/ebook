# =============================================================================
# API Gateway — the only public ingress for the KnowledgeOS API
# =============================================================================

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console          # json in deployed environments
PORT=8000

# --- token verification ------------------------------------------------------
# The gateway verifies access tokens offline against the auth service's JWKS.
# It holds NO private key and cannot mint tokens.
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
JWKS_CACHE_TTL=600

# --- service discovery -------------------------------------------------------
# On Railway replace each host with <service>.railway.internal
AUTH_SERVICE_URL=http://localhost:8001
BOOKS_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
AUTOMATION_SERVICE_URL=http://localhost:8007
ADMIN_SERVICE_URL=http://localhost:8008

# --- signing internal calls --------------------------------------------------
# Must be IDENTICAL on every service. Private-network reachability is not
# authorisation: upstreams verify this signature on /internal routes.
INTERNAL_API_SECRET=dev-internal-secret-change-me   # REQUIRED-IN-PROD

# --- redis (cache, rate limits, ban denylist) --------------------------------
REDIS_URL=redis://localhost:6379/0

# --- response cache ----------------------------------------------------------
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=60
CACHE_MAX_BODY_BYTES=1048576   # 1MB; larger responses stream but are not stored

# --- rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- ban denylist ------------------------------------------------------------
# Written by the auth service. Existence of the key means banned.
DENYLIST_ENABLED=true
DENYLIST_KEY_TEMPLATE=kos:denylist:user:{user_id}

# --- upstream transport ------------------------------------------------------
UPSTREAM_MAX_CONNECTIONS=200
UPSTREAM_CONNECT_TIMEOUT=5.0
UPSTREAM_READ_TIMEOUT=30.0

# --- aggregated docs ---------------------------------------------------------
OPENAPI_ENABLED=true
OPENAPI_CACHE_TTL=300

# --- events (cache invalidation) ---------------------------------------------
EVENTS_ENABLED=true
EVENT_CONSUMER_GROUP=gateway

# --- networking --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000     # never "*" in production
TRUSTED_HOSTS=*                        # real hostnames in production
FRONTEND_URL=http://localhost:3000
MAX_REQUEST_BODY_BYTES=26214400

METRICS_ENABLED=true
