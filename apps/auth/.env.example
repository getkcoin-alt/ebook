# =============================================================================
# Auth service
# =============================================================================
# Local development works with these defaults and no external accounts.
# Values marked REQUIRED-IN-PROD must be supplied before deploying —
# see docs/MANUAL_SETUP.md.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console          # json in deployed environments
PORT=8001

# --- datastores --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://knowledgeos:knowledgeos_dev_password@localhost:5432/knowledgeos
REDIS_URL=redis://localhost:6379/0
DATABASE_SCHEMA=auth        # do not change; other services read nothing here

# --- token signing -----------------------------------------------------------
# Generate with ./scripts/generate-keys.sh
# Newlines may be written as literal \n — settings.py un-escapes them.
#
# Leave BLANK for local development: a throwaway keypair is generated at boot.
# In production the service refuses to start without one, because an ephemeral
# key would invalidate every session on every restart and replicas would disagree.
JWT_PRIVATE_KEY=            # REQUIRED-IN-PROD — this service ONLY
JWT_PUBLIC_KEY=             # derived from the private key when omitted
JWT_PREVIOUS_PUBLIC_KEY=    # set during a rotation, cleared afterwards

JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
JWKS_URL=http://localhost:8001/.well-known/jwks.json

# --- token lifetimes (seconds) -----------------------------------------------
ACCESS_TOKEN_TTL=900        # 15 min. This IS the revocation window — see ADR 0003.
REFRESH_TOKEN_TTL=2592000   # 30 days, rotated on every use, revocable
MFA_CHALLENGE_TTL=300
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600
OAUTH_STATE_TTL=600

# --- service-to-service ------------------------------------------------------
# Signs internal calls. Must be IDENTICAL on every service.
#   openssl rand -hex 32
INTERNAL_API_SECRET=dev-internal-secret-change-me   # REQUIRED-IN-PROD

# --- credentials policy ------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Minimum duration of any credential response, so an early return for an unknown
# address cannot be distinguished from a full bcrypt verification.
CREDENTIAL_RESPONSE_FLOOR_MS=120

# --- cookies -----------------------------------------------------------------
REFRESH_COOKIE_NAME=kos_refresh
CSRF_COOKIE_NAME=kos_csrf
COOKIE_PATH=/v1/auth
COOKIE_DOMAIN=
COOKIE_SECURE=false         # MUST be true in production

# --- two-factor --------------------------------------------------------------
TOTP_ISSUER=KnowledgeOS
TOTP_DIGITS=6
TOTP_PERIOD=30
# Fernet key (urlsafe base64, 32 bytes) encrypting TOTP secrets at rest.
# Derived from INTERNAL_API_SECRET when unset.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
RECOVERY_CODE_COUNT=10

# --- OAuth (optional — providers stay hidden when unset) ---------------------
# Callback: {OAUTH_REDIRECT_BASE_URL}/v1/auth/oauth/{provider}/callback
# Must match the provider's registered URI byte for byte.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# --- networking --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000     # never "*" in production
TRUSTED_HOSTS=*                        # real hostnames in production
FRONTEND_URL=http://localhost:3000

# --- observability -----------------------------------------------------------
METRICS_ENABLED=true
