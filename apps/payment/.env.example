# Payment service configuration.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables — see docs/MANUAL_SETUP.md for which ones you must supply yourself.
#
# Anything marked REQUIRED-FOR-LIVE has no safe default. The service still boots
# without it (so a half-configured deployment passes its health check) but the
# corresponding gateway is simply unavailable.

# ---- identity --------------------------------------------------------------
SERVICE_NAME=payment
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
PORT=8005
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- datastores ------------------------------------------------------------
# The payment service owns the `payment` schema in the shared database.
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos
DATABASE_SCHEMA=payment
REDIS_URL=redis://localhost:6379/0

# ---- auth ------------------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api

# Shared secret for signing service-to-service calls. Must match every other
# service. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=dev-internal-secret-change-me

# ---- service discovery -----------------------------------------------------
# Book prices are read from here over a signed internal call. The payment service
# never queries the books schema directly.
BOOKS_SERVICE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# ---- networking ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# Where a gateway may send the customer after payment. An unvalidated return URL
# is an open redirect from a page the customer already trusts, so anything not
# listed here is refused.
ALLOWED_RETURN_ORIGINS=http://localhost:3000

# ---- currency and tax ------------------------------------------------------
DEFAULT_CURRENCY=INR
# GST on digital goods in India. A legal figure — verify it before invoicing.
GST_PERCENT=18
# Your registered state. Intra-state sales split into CGST+SGST; inter-state is a
# single IGST line. Getting this wrong misfiles the tax, not just the label.
SELLER_STATE_CODE=GJ
# true when catalogue prices already include GST (the Indian retail norm): the tax
# is extracted from the price rather than added on top, so a page that says ₹499
# charges ₹499.
PRICES_INCLUDE_TAX=true
INVOICE_PREFIX=KOS
SELLER_LEGAL_NAME=KnowledgeOS
# REQUIRED-FOR-LIVE if you are GST-registered — it must appear on every invoice.
SELLER_GSTIN=

# ---- Razorpay --------------------------------------------------------------
# REQUIRED-FOR-LIVE. Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED-FOR-LIVE, and a *different* value from the key secret above.
# Dashboard -> Settings -> Webhooks. Without it the service cannot prove a callback
# came from Razorpay, so it refuses every webhook rather than trusting the payload.
# Webhook URL: https://<gateway>/api/v1/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# ---- Stripe ----------------------------------------------------------------
# Optional. Configure only if you sell outside India.
STRIPE_SECRET_KEY=
# Public by design — it identifies the merchant to Stripe's browser SDK.
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or Dashboard -> Developers -> Webhooks.
# Webhook URL: https://<gateway>/api/v1/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired,
#         payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=
# Signatures older than this many seconds are rejected as replays.
STRIPE_SIGNATURE_TOLERANCE=300

# ---- behaviour -------------------------------------------------------------
# How long an unpaid order lives before the worker expires it and returns its
# coupon. Too short strands customers mid-payment; too long holds single-use codes.
ORDER_TTL_SECONDS=3600
IDEMPOTENCY_TTL=86400
MAX_ORDER_ITEMS=50
PROVIDER_HTTP_TIMEOUT=20
MAX_WEBHOOK_BODY_BYTES=1048576

# ---- affiliates ------------------------------------------------------------
# Commission in basis points (500 = 5%). Basis points, not percent, because 2.5%
# is not an integer percentage and a float rate loses money to rounding.
AFFILIATE_COMMISSION_BPS=500
# Days a conversion stays `pending` before it becomes payable. Paying out before
# the refund window closes means clawing money back later.
AFFILIATE_HOLD_DAYS=14

# ---- events ----------------------------------------------------------------
EVENTS_ENABLED=true
EVENT_CONSUMER_GROUP=payment
