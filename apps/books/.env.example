# =============================================================================
# Book service — catalogue, reviews, reading, entitlements
# =============================================================================

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
PORT=8002

DATABASE_URL=postgresql+asyncpg://knowledgeos:knowledgeos_dev_password@localhost:5432/knowledgeos
DATABASE_SCHEMA=books        # do not change; no other service reads these tables
REDIS_URL=redis://localhost:6379/0

# --- token verification ------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api

# Signs internal calls; must match every other service.
INTERNAL_API_SECRET=dev-internal-secret-change-me   # REQUIRED-IN-PROD

# --- object storage (book files, covers) -------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # what the BROWSER resolves; differs on Railway
S3_ACCESS_KEY=knowledgeos
S3_SECRET_KEY=knowledgeos_dev_password
S3_BUCKET=knowledgeos
S3_USE_SSL=false

# --- catalogue behaviour -----------------------------------------------------
CACHE_ENABLED=true
BOOK_CACHE_TTL=300
CATEGORY_TREE_CACHE_TTL=900
MAX_CURSOR_LIMIT=100
DEFAULT_CURSOR_LIMIT=20
RELATED_BOOKS_LIMIT=12
REVIEWS_REQUIRE_MODERATION=false
# Zero-priced books readable by any signed-in user without an entitlement row.
FREE_BOOKS_READABLE=true

# --- downloads ---------------------------------------------------------------
# Short: the signed URL IS the capability, so a link leaked in a screenshot
# should go stale quickly.
DOWNLOAD_URL_TTL=300
MAX_BOOK_UPLOAD_BYTES=209715200
MAX_COVER_UPLOAD_BYTES=10485760

# --- events ------------------------------------------------------------------
# Consumes payment.succeeded / order.paid to grant entitlements.
EVENTS_ENABLED=true
EVENT_CONSUMER_GROUP=books

CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
METRICS_ENABLED=true
