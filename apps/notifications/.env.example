# Notification service configuration.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables — see docs/MANUAL_SETUP.md.

# ---- identity --------------------------------------------------------------
SERVICE_NAME=notifications
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
PORT=8006
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- datastores ------------------------------------------------------------
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos
DATABASE_SCHEMA=notifications
REDIS_URL=redis://localhost:6379/0

# ---- auth ------------------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
INTERNAL_API_SECRET=dev-internal-secret-change-me

# ---- networking ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- sender identity -------------------------------------------------------
FROM_EMAIL=noreply@knowledgeos.dev
FROM_NAME=KnowledgeOS
# Where a human reply actually goes. Sending from a no-reply address with no
# reply-to is a good way to lose a customer who hits reply.
REPLY_TO_EMAIL=
SUPPORT_EMAIL=support@knowledgeos.dev

# ---- email provider --------------------------------------------------------
# "console" | "smtp" | "resend".
#
# `console` logs the message instead of sending it. It is the default and what CI
# runs against — everything upstream of the network call (preferences, suppression,
# rendering, delivery records, retries) is exercised exactly as in production.
EMAIL_PROVIDER=console

# --- SMTP (EMAIL_PROVIDER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Resend (EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=
# Verifies inbound delivery webhooks. Without it they cannot be trusted, so they
# are refused rather than believed.
RESEND_WEBHOOK_SECRET=

# ---- sms / whatsapp (optional) ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ---- push (optional) -------------------------------------------------------
FCM_SERVER_KEY=

# ---- unsubscribe -----------------------------------------------------------
# Signs unsubscribe links. Generate with: openssl rand -hex 32
#
# REQUIRED in production. With the default, unsubscribe tokens are forgeable and
# anyone can unsubscribe anyone — a one-line way to silence every customer.
UNSUBSCRIBE_SECRET=dev-unsubscribe-secret-change-me
UNSUBSCRIBE_URL=http://localhost:3000/unsubscribe

# ---- behaviour -------------------------------------------------------------
# Messages a user may never opt out of. Keep this short and honest: a receipt and
# a password reset belong here, a "new books this week" digest does not.
TRANSACTIONAL_CATEGORIES=account.verify,account.password_reset,account.security,order.receipt,order.refund

MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_SECONDS=30
PROVIDER_TIMEOUT=20
IN_APP_RETENTION=500
DELIVERY_RETENTION_DAYS=90

# The switch to pull during an incident, or when a production database has been
# restored into staging and must not re-mail every customer in it. Off records the
# intent and sends nothing.
SENDING_ENABLED=true

# Whether a hard bounce or spam complaint permanently blocks an address.
#
# Leave this on. Mail sent to an address that already complained damages the
# sending domain's reputation for *every* message the platform sends — password
# resets included.
SUPPRESSION_ENFORCED=true

# ---- events ----------------------------------------------------------------
EVENTS_ENABLED=true
EVENT_CONSUMER_GROUP=notifications
