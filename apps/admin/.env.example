# Admin service configuration.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables — see docs/MANUAL_SETUP.md.

# ---- identity --------------------------------------------------------------
SERVICE_NAME=admin
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
PORT=8008
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- datastores ------------------------------------------------------------
# This service owns two tables: feature flags and their audit history. Every
# number on the dashboard belongs to the service that produced it.
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos
DATABASE_SCHEMA=admin
# Without Redis, every dashboard render fans out to every service live. A few
# operators with the page open then produce more internal traffic than the
# storefront, so the service logs a warning if it starts without one.
REDIS_URL=redis://localhost:6379/0

# ---- auth ------------------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
INTERNAL_API_SECRET=dev-internal-secret-change-me

# ---- service discovery -----------------------------------------------------
# Every service the dashboard reads from. A missing URL shows as an unavailable
# card rather than breaking the page.
AUTH_SERVICE_URL=http://localhost:8001
BOOKS_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
AUTOMATION_SERVICE_URL=http://localhost:8007
WORKERS_SERVICE_URL=http://localhost:8009

# ---- fan-out ---------------------------------------------------------------
# Which panels appear, in display order. Drop a service here and its card
# disappears — the right move on a deployment that does not run it.
PANELS=books,payment,search,notification,ai,automation,workers

# Per-panel read budget. Short on purpose: a card that says "unavailable" is far
# better than a page that hangs.
PANEL_TIMEOUT=5.0
# Whole-page ceiling, for when several panels are slow at once.
DASHBOARD_TIMEOUT=12.0

# ---- caching ---------------------------------------------------------------
# Short: a dashboard is read far more often than its numbers change, but an
# operator watching a deploy needs to see movement within a minute.
DASHBOARD_CACHE_TTL=60
HEALTH_CACHE_TTL=15

# ---- feature flags ---------------------------------------------------------
# How long a sibling may cache a flag — the lag between flipping it and it taking
# effect everywhere.
FLAG_CACHE_TTL=30
# Flag changes are audited. "Who turned payments off" is a question that arrives
# long after the flag was turned back on.
FLAG_AUDIT_RETENTION_DAYS=365

EVENTS_ENABLED=false
