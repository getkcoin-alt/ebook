# AI service configuration.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables — see docs/MANUAL_SETUP.md.

# ---- identity --------------------------------------------------------------
SERVICE_NAME=ai
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
PORT=8004
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- datastores ------------------------------------------------------------
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos
DATABASE_SCHEMA=ai
REDIS_URL=redis://localhost:6379/0

# ---- auth ------------------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
INTERNAL_API_SECRET=dev-internal-secret-change-me

# ---- service discovery -----------------------------------------------------
# Chat grounds its answers in real catalogue results, and a book-scoped
# conversation verifies entitlement with the books service before any of the
# book's text reaches a prompt.
BOOKS_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003

# ---- networking ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---- providers -------------------------------------------------------------
# Preference order. The first configured one is primary; the rest are failover
# for when it is rate-limited or down.
PROVIDER_ORDER=anthropic,openai

# At least one is REQUIRED for any AI feature to work. Without either, the
# service still boots and reports itself unavailable through /v1/ai/status.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Also used by the search service when SEMANTIC_ENABLED is on.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- cost control ----------------------------------------------------------
# READ THIS BEFORE DEPLOYING.
#
# This is the only service on the platform that fails by spending money. Every
# other one fails by being unavailable, which is loud. A retry loop against a
# paid model is silent until the invoice arrives.
#
# The ceiling is a HARD STOP, not a target. Reaching it returns 503 and serves
# nothing for the rest of the UTC day. That is deliberate: an AI feature that is
# off until tomorrow is a worse product, and an uncapped one is a worse business.
#
# Start low. You can always raise it.
DAILY_COST_LIMIT_USD=50
# Per user, so one account cannot consume the whole platform budget — otherwise
# the first person to write a script takes the feature away from everyone else.
USER_DAILY_COST_LIMIT_USD=2
# Fraction of the ceiling at which a warning is logged, so someone can look
# before the feature switches itself off.
COST_WARNING_THRESHOLD=0.8
COST_TRACKING_ENABLED=true

# ---- limits ----------------------------------------------------------------
REQUEST_TIMEOUT=120
MAX_OUTPUT_TOKENS=4096
# A 200k-token document sent to a paid model by accident is a four-figure mistake.
MAX_INPUT_CHARS=120000

# ---- caching ---------------------------------------------------------------
# The difference between an affordable feature and an expensive one. Book copy is
# generated once and read thousands of times; regenerating it per request is pure
# waste, and non-determinism means the description changes for no reason a reader
# would understand.
CACHE_ENABLED=true
CACHE_TTL=86400

# ---- moderation ------------------------------------------------------------
MODERATION_ENABLED=true
# Refuse rather than allow when the classifier is unavailable. An unmoderated
# path opens exactly when moderation is under strain, which is when it matters
# most. Turn this off only if you have another moderation layer.
MODERATION_FAIL_CLOSED=true

# ---- retention -------------------------------------------------------------
CONVERSATION_RETENTION_DAYS=90
MAX_CONVERSATIONS_PER_USER=50

# ---- events ----------------------------------------------------------------
EVENTS_ENABLED=true
EVENT_CONSUMER_GROUP=ai
