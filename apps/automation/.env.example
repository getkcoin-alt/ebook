# Automation service configuration.
#
# Copy to `.env` for local development. On Railway these are set as service
# variables — see docs/MANUAL_SETUP.md.

# ---- identity --------------------------------------------------------------
SERVICE_NAME=automation
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
PORT=8007
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- datastores ------------------------------------------------------------
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos
DATABASE_SCHEMA=automation
REDIS_URL=redis://localhost:6379/0

# ---- object storage --------------------------------------------------------
# The pipeline reads source files from here and writes every derived artefact
# back. Derived objects go beside the source, never over it: the uploader's
# original is the only thing here that cannot be regenerated.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=knowledgeos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- auth ------------------------------------------------------------------
JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
INTERNAL_API_SECRET=dev-internal-secret-change-me

# ---- service discovery -----------------------------------------------------
# The pipeline reads the catalogue record before enriching, writes its output
# back when it finishes, and asks search to index the result.
BOOKS_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004

# ---- source limits ---------------------------------------------------------
# Every later stage loads the file into memory, so an unbounded source is an
# unbounded worker RSS — and a worker that OOMs takes every other job on it down.
MAX_SOURCE_BYTES=524288000
# An EPUB is a zip. This bounds what it may expand to; the archive's own size
# says nothing about that, and a 2MB zip bomb passes every upload check.
MAX_DECOMPRESSED_BYTES=1073741824
MAX_ARCHIVE_ENTRIES=10000
ACCEPTED_FORMATS=pdf,epub

# ---- text extraction -------------------------------------------------------
# Enough to characterise a book; far less than the whole thing, which nothing
# downstream needs and every model provider charges for.
EXCERPT_CHARS=12000
EXCERPT_MAX_PAGES=40

# ---- derived artefacts -----------------------------------------------------
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=600
COVER_WIDTH=1000
COVER_HEIGHT=1500
IMAGE_QUALITY=82
# Skip compression below this gain. Rewriting a 200MB PDF to save 1% burns CPU
# and diverges the distribution copy from the master for nothing.
MIN_COMPRESSION_GAIN=0.05
WATERMARK_ENABLED=true
WATERMARK_TEXT=KnowledgeOS

# ---- pipeline behaviour ----------------------------------------------------
# Enrichment stages do not block publication: a book with no AI tags is still
# publishable, and blocking on a provider outage makes a backlog nobody can clear.
AI_STAGES_OPTIONAL=true
AI_ENABLED=true
SEARCH_INDEXING_ENABLED=true

# OFF by default, and it should stay off in production. A pipeline that publishes
# whatever it is handed puts machine-written copy in front of customers with
# nobody having read it.
AUTO_PUBLISH=false

MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=3600
STALE_JOB_SECONDS=3600
JOB_RETENTION_DAYS=90

# Runs jobs in the API process instead of dispatching to a Celery worker. A
# development convenience only — it puts a CPU-bound job on the event loop that
# is serving requests.
INLINE_EXECUTION=false

# ---- events ----------------------------------------------------------------
EVENTS_ENABLED=true
EVENT_CONSUMER_GROUP=automation
