# =============================================================================
# KnowledgeOS — root environment template
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
#
# The defaults below match infrastructure/docker/docker-compose.yml, so a fresh
# checkout works with no edits. Values you must replace before deploying are
# marked REQUIRED-IN-PROD and listed in docs/MANUAL_SETUP.md.
#
# Never commit a real .env. .gitignore already excludes it.
# =============================================================================

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=local                     # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                    # console locally, json in deployed envs

# --- datastores ---------------------------------------------------------------
# Railway supplies these as reference variables: ${{Postgres.DATABASE_URL}}
# A `postgres://` scheme is rewritten to `postgresql+asyncpg://` automatically.
DATABASE_URL=postgresql+asyncpg://knowledgeos:knowledgeos_dev_password@localhost:5432/knowledgeos
REDIS_URL=redis://localhost:6379/0

# --- object storage (MinIO locally, any S3 provider in production) -------------
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # browser-reachable host; differs on Railway
S3_ACCESS_KEY=knowledgeos
S3_SECRET_KEY=knowledgeos_dev_password         # REQUIRED-IN-PROD
S3_BUCKET=knowledgeos
S3_REGION=us-east-1
S3_USE_SSL=false                               # true in production
S3_SIGNATURE_TTL=900                           # seconds a download link stays valid

# --- search --------------------------------------------------------------------
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=knowledgeos_dev_master_key_min_16_bytes   # REQUIRED-IN-PROD

# --- authentication ------------------------------------------------------------
# Access tokens are RS256. The auth service holds the private key; every other
# service verifies via the public JWKS endpoint. Generate a keypair with:
#   ./scripts/generate-keys.sh
# Newlines must be written as \n when set through the Railway dashboard.
JWT_PRIVATE_KEY=                      # REQUIRED-IN-PROD — auth service only
JWT_PUBLIC_KEY=                       # REQUIRED-IN-PROD
JWT_ISSUER=knowledgeos-auth
JWT_AUDIENCE=knowledgeos-api
JWKS_URL=http://localhost:8001/.well-known/jwks.json
ACCESS_TOKEN_TTL=900                  # 15 min — short, because it cannot be revoked
REFRESH_TOKEN_TTL=2592000             # 30 days — revocable, stored server-side

# Signs service-to-service calls. Private-network reachability is not authorisation.
#   openssl rand -hex 32
INTERNAL_API_SECRET=dev-internal-secret-change-me    # REQUIRED-IN-PROD

# --- OAuth providers -----------------------------------------------------------
# Callback: {API_URL}/v1/auth/oauth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- payments ------------------------------------------------------------------
# Webhook secrets verify that a callback genuinely came from the provider. A
# missing secret means anyone who knows the URL can mark an order paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=INR
GST_PERCENT=18                        # India GST on digital goods

# --- AI providers ---------------------------------------------------------------
# At least one is needed for the automation pipeline's description/tag stages.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-5
AI_MONTHLY_BUDGET_USD=100             # pipeline pauses rather than overspending

# --- notifications ---------------------------------------------------------------
# Mailpit catches all local mail at http://localhost:8025 — nothing escapes.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@knowledgeos.dev
SMTP_FROM_NAME=KnowledgeOS
SMTP_USE_TLS=false                    # true in production

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
FCM_CREDENTIALS_JSON=                 # service-account JSON, single line

# --- frontend ---------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the browser bundle. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KnowledgeOS

# --- service discovery ------------------------------------------------------------
# On Railway replace each host with <service>.railway.internal
AUTH_SERVICE_URL=http://localhost:8001
BOOKS_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
AUTOMATION_SERVICE_URL=http://localhost:8007
ADMIN_SERVICE_URL=http://localhost:8008

# --- networking -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*                       # set to real hostnames in production
MAX_REQUEST_BODY_BYTES=26214400       # 25MB

# --- observability -----------------------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
